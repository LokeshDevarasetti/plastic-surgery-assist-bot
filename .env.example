# Required: a Claude API key (https://console.anthropic.com, Settings, API Keys).
# The app uses Claude Haiku 5.5 by default.
ANTHROPIC_API_KEY=

# Optional usage limits (each question costs a fraction of a cent)
# DAILY_REQUEST_LIMIT=500
# PER_IP_PER_HOUR=15

# Optional: use a different model
# LLM_MODEL=claude-haiku-5-5

# Optional fallback: any OpenAI-compatible service such as Groq.
# Only used when ANTHROPIC_API_KEY is empty.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
